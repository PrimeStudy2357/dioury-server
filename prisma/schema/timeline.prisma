model Timeline {
  id           Int              @id @default(autoincrement())
  name         String           @unique
  isPublic     Boolean
  profileImage String
  category     String
  keyword1     String
  keyword2     String?
  keyword3     String?
  description  String
  period       String
  isOn         Boolean
  memberCnt    Int
  members      TimelineMember[]
  likeCnt      Int
  creator      User             @relation(fields: [creatorName], references: [nickname])
  creatorName  String
  createdAt    DateTime         @default(now())

  @@map("timelines")
}

enum TimelineRole {
  OWNER
  ADMIN
  // 글 작성 가능한 멤버
  FRIEND
  // 읽기만 가능한 멤버
  MEMBER
}

model TimelineMember {
  userId     Int
  timelineId Int
  role       TimelineRole
  joinedAt   DateTime     @default(now())

  user     User     @relation(fields: [userId], references: [id])
  timeline Timeline @relation(fields: [timelineId], references: [id])

  @@id([userId, timelineId])

  @@map("timeline_member")
}

view TimelineListView {
  name         String   @unique
  isPublic     Boolean
  profileImage String
  keyword1     String
  keyword2     String?
  keyword3     String?
  period       String
  isOn         Boolean
  memberCnt    Int
  creatorName  String
  createdAt    DateTime @default(now())

  @@map("timeline_list_view")
}
