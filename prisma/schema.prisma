// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["views"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id  Int @id @default(autoincrement())
  email   String  @unique
  password  String  @db.VarChar(100)
  nickname  String  @db.VarChar(100) @unique
  funnel    String  @db.VarChar(100) // 유입경로
  purpose   String @db.VarChar(100) // 사용목적
  createdAt DateTime @default(now())
  myTimeline Timeline[]
  joinedTimelines TimelineMember[]
  @@map("users")
}

model Timeline {
  id  Int @id @default(autoincrement())
  name  String @unique
  isPublic  Boolean
  profileImage  String
  category String
  keyword1 String
  keyword2 String?
  keyword3 String?
  description String
  period  String
  isOn  Boolean
  memberCnt Int
  members TimelineMember[]
  likeCnt Int
  creator User @relation(fields: [creatorName], references: [nickname])
  creatorName String
  createdAt DateTime  @default(now())
  @@map("timelines")
}

enum TimelineRole {
  OWNER
  ADMIN
  // 글 작성 가능한 멤버
  FRIEND
  // 읽기만 가능한 멤버
  MEMBER
}

model TimelineMember {
  userId  Int
  timelineId  Int
  role TimelineRole
  joinedAt  DateTime  @default(now())

  user  User  @relation(fields: [userId], references: [id])
  timeline  Timeline  @relation(fields: [timelineId], references: [id])

  @@id([userId, timelineId])  
}

view TimelineListView {
  name  String @unique
  isPublic  Boolean
  profileImage  String
  keyword1 String
  keyword2 String?
  keyword3 String?
  period  String
  isOn  Boolean
  memberCnt Int
  creatorName String
  createdAt DateTime  @default(now())
  @@map("timeline_list_view")
}